</style>

<div class="screen">
  <div class="grid-line-h"></div>
  <div class="grid-line-left"></div>
  <div class="grid-line-right"></div>

  <div class="header">
    <div class="brand">
      <div class="brand-mark"><Rocket width="20" height="20" color="#130905" /></div>
      <div class="brand-copy">
        <span class="brand-title">LAUNCH OPS</span>
        <span class="brand-sub">MISSION AURORA-7 / ORBIT INSERTION</span>
      </div>
    </div>
    <div class="header-status">
      <div class="pill pill-orange"><div class="dot orange-dot"></div><span class="pill-text text-orange">ARMED</span></div>
      <div class="pill pill-green"><div class="dot green-dot"></div><span class="pill-text text-green">ALL SYSTEMS NOMINAL</span></div>
    </div>
    <div class="header-countdown">
      <span class="count-label">COUNTDOWN</span>
      <span class="count-main">T-00:42:18</span>
    </div>
  </div>

  <div class="sidebar">
    <span class="section-label">COMMAND</span>
    <div class="nav-item nav-active"><Activity width="18" height="18" color="#39D6FF" /><span class="nav-text nav-active-text">Launch Console</span></div>
    <div class="nav-item"><Radio width="18" height="18" color="#8C9AAA" /><span class="nav-text text-muted">Ground Links</span></div>
    <div class="nav-item"><Route width="18" height="18" color="#8C9AAA" /><span class="nav-text text-muted">Trajectory</span></div>
    <div class="nav-item"><ShieldCheck width="18" height="18" color="#8C9AAA" /><span class="nav-text text-muted">Abort Rules</span></div>
    <div class="divider"></div>
    <div class="mission-card">
      <span class="section-label">MISSION PHASE</span>
      <span class="mission-title">FINAL HOLD</span>
      <span class="body-copy">Autonomous checks complete. Awaiting ignition clearance from flight director.</span>
    </div>
    <div class="metric-list">
      <div class="metric-row"><span class="metric-key">LINK</span><span class="metric-value text-green">99.98%</span></div>
      <div class="metric-row"><span class="metric-key">RANGE</span><span class="metric-value text-cyan">CLEAR</span></div>
    </div>
    <div class="abort-button"><span class="abort-text">ABORT SAFE</span></div>
  </div>

  <div class="main">
    <div class="kpis">
      <div class="kpi-card"><span class="kpi-label">ALTITUDE</span><span class="kpi-value">12.8 KM</span><span class="kpi-sub text-green">+0.42 km/s ascent</span></div>
      <div class="kpi-card"><span class="kpi-label">VELOCITY</span><span class="kpi-value">2,941 M/S</span><span class="kpi-sub text-cyan">target corridor</span></div>
      <div class="kpi-card"><span class="kpi-label">FUEL MASS</span><span class="kpi-value">78%</span><span class="kpi-sub text-green">nominal reserve</span></div>
    </div>

    <div class="trajectory">
      <span class="traj-title">TRAJECTORY MONITOR</span>
      <span class="traj-status">ASCENT VECTOR LOCKED</span>
      <div class="orbit-wide"></div>
      <div class="orbit-tight"></div>
      <div class="axis"></div>
      <div class="plume-cyan"></div>
      <div class="plume-orange"></div>
      <div class="rocket-fin-left"></div>
      <div class="rocket-fin-right"></div>
      <div class="rocket-body"></div>
      <div class="rocket-nose"></div>
      <div class="rocket-mask"></div>
      <div class="rocket-window"></div>
      <div class="readouts">
        <div class="readout"><span class="readout-label">PITCH</span><span class="readout-value text-cyan">87.4 DEG</span></div>
        <div class="readout"><span class="readout-label">APOGEE</span><span class="readout-value text-main">412 KM</span></div>
        <div class="readout"><span class="readout-label">DRIFT</span><span class="readout-value text-green">0.03 DEG</span></div>
      </div>
    </div>

    <div class="ops-table">
      <div class="table-row table-head">
        <span class="cell-system th">SYSTEM</span><span class="cell-state th">STATE</span><span class="cell-value th">VALUE</span><span class="cell-trend th">TREND</span>
      </div>
      <div class="table-row">
        <span class="cell-system td-main">Main Engine</span><span class="cell-state td-code text-green">Ready</span><span class="cell-value td-code text-main">100%</span><div class="cell-trend bar-track"><div class="bar-fill" style="width: 192; background-color: #64F4AC"></div></div>
      </div>
      <div class="table-row">
        <span class="cell-system td-main">Telemetry</span><span class="cell-state td-code text-cyan">Streaming</span><span class="cell-value td-code text-main">4.8 GB/S</span><div class="cell-trend bar-track"><div class="bar-fill" style="width: 168; background-color: #39D6FF"></div></div>
      </div>
      <div class="table-row">
        <span class="cell-system td-main">Thermal</span><span class="cell-state td-code text-green">Stable</span><span class="cell-value td-code text-main">621 K</span><div class="cell-trend bar-track"><div class="bar-fill" style="width: 112; background-color: #64F4AC"></div></div>
      </div>
      <div class="table-row table-last">
        <span class="cell-system td-main">Range Safety</span><span class="cell-state td-code text-cyan">Clear</span><span class="cell-value td-code text-main">GREEN</span><div class="cell-trend bar-track"><div class="bar-fill" style="width: 198; background-color: #39D6FF"></div></div>
      </div>
    </div>
  </div>

  <div class="right-rail">
    <div class="rail-card action-card">
      <span class="section-label">PRIMARY ACTION</span>
      <div class="launch-button"><span class="launch-button-text">CLEAR IGNITION</span></div>
      <span class="body-copy">Requires two-person confirmation</span>
    </div>
    <div class="rail-card health-card">
      <span class="section-label">SYSTEM HEALTH</span>
      <div class="health-row"><span class="health-name">Propulsion</span><span class="health-value text-green">98%</span></div>
      <div class="bar-track"><div class="bar-fill" style="width: 250; background-color: #64F4AC"></div></div>
      <div class="health-row"><span class="health-name">Comms</span><span class="health-value text-cyan">92%</span></div>
      <div class="bar-track"><div class="bar-fill" style="width: 232; background-color: #39D6FF"></div></div>
      <div class="health-row"><span class="health-name">Cryo Load</span><span class="health-value text-orange">81%</span></div>
      <div class="bar-track"><div class="bar-fill" style="width: 204; background-color: #FF7A1A"></div></div>
    </div>
    <div class="log-card">
      <div class="log-head"><span class="section-label">LIVE EVENT LOG</span></div>
      <div class="log-row"><span class="log-time text-cyan">T-00:42:18</span><span class="log-text">Flight computer entered final hold.</span></div>
      <div class="log-row"><span class="log-time text-green">T-00:44:02</span><span class="log-text">Range weather clearance received.</span></div>
      <div class="log-row"><span class="log-time text-orange">T-00:47:29</span><span class="log-text">Cryogenic load pressure settling.</span></div>
      <div class="log-row"><span class="log-time text-muted">T-00:51:10</span><span class="log-text">Telemetry recorders synchronized.</span></div>
    </div>
  </div>
</div>

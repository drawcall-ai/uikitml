{
  "name": "@drawcall/uikitml",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/drawcall-ai/uikitml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "uikitml": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.render.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pmndrs/msdfonts": "^1.0.71",
    "@pmndrs/uikit": "^1.0.71",
    "@pmndrs/uikit-horizon": "^1.0.71",
    "@pmndrs/uikit-lucide": "^1.0.71",
    "@preact/signals-core": "^1.5.1",
    "@sentry/node": "^10.55.0",
    "commander": "^14.0.3",
    "entities": "^6.0.1",
    "moo": "^0.5.3",
    "nearley": "^2.20.1",
    "playwright": "^1.60.0",
    "three": ">=0.162",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nearley": "^2.11.5",
    "@types/three": "^0.184.0",
    "jsdom": "^26.1.0",
    "vite": "^8.0.13"
  },
  "peerDependencies": {
    "@pmndrs/uikit": "^1.0.71",
    "three": ">=0.162"
  }
}
